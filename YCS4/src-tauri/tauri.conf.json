{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yebisu Creator Studio",
  "version": "0.1.0",
  "identifier": "com.yebisu.ycs4",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yebisu Creator Studio",
        "width": 800,
        "height": 600,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
